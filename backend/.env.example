DJANGO_SETTINGS_MODULE=config.settings.development
# Generate two independent random values; never use these placeholders.
DJANGO_SECRET_KEY=replace-me-with-at-least-50-random-characters
JWT_SIGNING_KEY=replace-me-with-an-independent-50-character-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=navapack
POSTGRES_USER=navapack
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Production requires verify-full; configure libpq's trusted root CA.
POSTGRES_SSLMODE=prefer
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
TRUST_PROXY_HTTPS=false
LOG_LEVEL=INFO
