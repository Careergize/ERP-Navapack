# Template only. Inject independently generated secrets through the hosting secret store.
DJANGO_SETTINGS_MODULE=config.settings.demo
APP_ENV=DEMO
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=replace-me-demo-api.example.invalid
DJANGO_SECRET_KEY=replace-me-independent-django-secret
JWT_SIGNING_KEY=replace-me-independent-jwt-secret
DEMO_EXECUTION_SECRET=replace-me-independent-64-character-execution-secret
DEMO_INSTANCE_ID=replace-me-approved-uuid
DEMO_DATABASE_NAME=navapack_demo_replace_me_approved
POSTGRES_DB=navapack_demo_replace_me_approved
POSTGRES_USER=replace-me-restricted-runtime-role
POSTGRES_PASSWORD=replace-me-runtime-secret
POSTGRES_HOST=replace-me-external-tls-postgresql.example.invalid
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
CORS_ALLOWED_ORIGINS=https://replace-me-demo-frontend.example.invalid
CSRF_TRUSTED_ORIGINS=https://replace-me-demo-frontend.example.invalid
TRUST_PROXY_HTTPS=true
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
LOG_LEVEL=INFO
